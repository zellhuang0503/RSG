{
  "name": "rsg-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "關係花園 rsg.com.tw 主站（靜態站，Astro）",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "test:registration": "node --test tests/registration.test.mjs",
    "registration:seed": "node scripts/seed-registration.mjs",
    "registration:migrate:local": "wrangler d1 migrations apply rsg-registration-local --local --config wrangler.registration-local.jsonc",
    "registration:preview": "wrangler dev --config wrangler.registration-local.jsonc --ip 127.0.0.1 --port 4324 --test-scheduled",
    "import": "node scripts/import-export.mjs",
    "redirects": "node scripts/import-export.mjs --redirects-only"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.3"
  },
  "devDependencies": {
    "miniflare": "5.20260918.0-alpha",
    "pagefind": "^1.5.2",
    "wrangler": "^4.135.0"
  }
}
