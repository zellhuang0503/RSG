---
import type { CollectionEntry } from 'astro:content';
import { routeOf, formatDate, summaryOf, thumbnailOf } from '../lib/content';
interface Props { event: CollectionEntry<'events'>; }
const { event } = Astro.props;
const href = routeOf(event);
const d = event.data;
const thumb = thumbnailOf(event);
const range = d.end_date && d.end_date.slice(0, 10) !== d.start_date.slice(0, 10)
  ? `${formatDate(d.start_date, { month: 'numeric', day: 'numeric' })} – ${formatDate(d.end_date, { month: 'numeric', day: 'numeric' })}`
  : formatDate(d.start_date, { year: 'numeric', month: 'long', day: 'numeric', weekday: 'short' });
---
<article class="card event-card">
  {thumb && (
    <a class="thumb" href={href} tabindex="-1" aria-hidden="true"><img src={thumb} alt="" loading="lazy" /></a>
  )}
  <div class="body">
    {d.start_date && <span class="when"><time datetime={d.start_date}>{range}</time></span>}
    <h3><a href={href}>{d.title}</a></h3>
    {d.venue && <div class="meta">{d.venue}</div>}
    <p class="summary">{summaryOf(event)}</p>
  </div>
</article>
