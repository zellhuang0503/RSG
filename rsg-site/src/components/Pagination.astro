---
// 第 1 頁在 base，第 2 頁起在 base/2、base/3…
interface Props { current: number; totalPages: number; base: string; }
const { current, totalPages, base } = Astro.props;
const hrefOf = (n: number) => (n === 1 ? base : `${base}/${n}`);
const pages = Array.from({ length: totalPages }, (_, i) => i + 1).filter((n) => n === 1 || n === totalPages || Math.abs(n - current) <= 2);
---
{totalPages > 1 && (
  <nav class="pagination" aria-label="分頁">
    {current > 1 ? <a href={hrefOf(current - 1)} rel="prev">上一頁</a> : <span class="disabled">上一頁</span>}
    {pages.map((n, i) => (
      <>
        {i > 0 && pages[i - 1] !== n - 1 && <span class="disabled">…</span>}
        {n === current ? <span aria-current="page">{n}</span> : <a href={hrefOf(n)}>{n}</a>}
      </>
    ))}
    {current < totalPages ? <a href={hrefOf(current + 1)} rel="next">下一頁</a> : <span class="disabled">下一頁</span>}
  </nav>
)}
