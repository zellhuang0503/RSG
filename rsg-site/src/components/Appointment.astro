---
interface Props {
  title?: string;
  hours?: string;
  href?: string;
}
const { title = '我想預約', hours = '平日週一至週五 10:00 AM-18:00 PM', href = 'https://m.me/rsg.garden' } = Astro.props;
---
<section class="appointment-band" aria-label={title}>
  <div class="appointment-panel" data-reveal="left">
    <h2>{title}</h2>
    <p class="appointment-hours"><strong><span>服務時間／</span>{hours}</strong></p>
    <p class="appointment-description">我想預約或進一步了解，請洽線上客服，<br />將有專人與您聯繫預約時間與費用，謝謝。</p>
    <a class="appointment-link" href={href} aria-label="點我預約：聯絡關係花園線上客服">
      <img src="/media/2022/08/png_icon_點我預約.png" alt="點我預約" width="230" height="126" loading="lazy" />
    </a>
  </div>
</section>
