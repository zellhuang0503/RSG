---
import { site, org } from '../site';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container">
    <div class="cols">
      <div>
        <img class="footer-logo" src={site.logo} alt={site.name} width="220" height="70" loading="lazy" />
        <h3>{site.tagline}</h3>
        <p>{org.description}</p>
        <p class="social">{site.social.map((s) => <a href={s.href} target="_blank" rel="noopener">{s.label}</a>)}</p>
      </div>
      <div>
        <h3>{site.company}</h3>
        <ul class="contact">
          <li>{site.address}</li>
          <li>Mail：<a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li>LINE：{site.line}</li>
          <li>電話：<a href={`tel:${site.phone.replace(/-/g, '')}`}>{site.phone}</a></li>
          <li>傳真：{site.fax}</li>
        </ul>
      </div>
      <div>
        <h3>網站地圖</h3>
        <ul>
          {site.footerLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
          <li><a href="/search">搜尋</a></li>
          <li><a href="/feed.xml">RSS 訂閱</a></li>
        </ul>
      </div>
    </div>
    <p class="copy">© {org.foundingDate}–{year} {site.name}. All rights reserved.</p>
  </div>
</footer>
