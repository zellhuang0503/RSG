---
import { site } from '../site';
const current = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
const isActive = (href: string) => href === current || (href !== '/' && current.startsWith(href + '/'));
---
<header class="site-header classic">
  <div class="container brand-row">
    <a class="brand" href="/" aria-label={site.name}>
      <img src={site.logo} alt="" width="220" height="70" />
      <span class="wordmark">{site.shortName}<small>Relationship Garden</small></span>
    </a>
    <button type="button" class="nav-toggle-label" aria-label="開啟選單" aria-expanded="false" aria-controls="primary-nav"><span></span><span></span><span></span></button>
  </div>
  <div class="menubar">
    <div class="container">
    <nav id="primary-nav" class="nav" aria-label="主選單">
      {site.nav.map((item, index) => (
        item.children ? (
          <div class="nav-item has-children">
            <a href={item.href} aria-current={isActive(item.href) || item.children.some((c) => isActive(c.href) || c.children?.some((g) => isActive(g.href))) ? 'page' : undefined} aria-haspopup="true">{item.label}<span class="caret" aria-hidden="true">▾</span></a>
            <button type="button" class="submenu-toggle" aria-expanded="false" aria-controls={`nav-submenu-${index}`}>{item.label}<span class="caret" aria-hidden="true"></span></button>
            <div class="submenu" id={`nav-submenu-${index}`}>
              {item.children.map((c, childIndex) => (
                c.children ? (
                  <div class="nav-item sub has-children">
                    <a href={c.href} aria-haspopup="true">{c.label}<span class="caret" aria-hidden="true">▸</span></a>
                    <button type="button" class="submenu-toggle" aria-expanded="false" aria-controls={`nav-submenu-${index}-${childIndex}`}>{c.label}<span class="caret" aria-hidden="true"></span></button>
                    <div class="submenu flyout" id={`nav-submenu-${index}-${childIndex}`}>
                      {c.children.map((g) => <a href={g.href} aria-current={isActive(g.href) ? 'page' : undefined}>{g.label}</a>)}
                    </div>
                  </div>
                ) : (
                  <a href={c.href} aria-current={isActive(c.href) ? 'page' : undefined}>{c.label}</a>
                )
              ))}
            </div>
          </div>
        ) : (
          <a
            href={item.href}
            class:list={[{ external: item.external }]}
            aria-current={isActive(item.href) ? 'page' : undefined}
            target={item.external ? '_blank' : undefined}
            rel={item.external ? 'noopener' : undefined}
          >{item.label}</a>
        )
      ))}
      <details class="nav-search">
        <summary aria-label="開啟搜尋" title="搜尋">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" /><path d="m16 16 5 5" /></svg>
        </summary>
        <div class="nav-search-panel">
          <form action="/search" method="get" role="search" aria-label="導覽列站內搜尋">
            <label for="nav-search-query" class="visually-hidden">搜尋本站</label>
            <input id="nav-search-query" type="search" name="q" placeholder="搜尋…" required />
            <button type="submit" aria-label="搜尋">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" /><path d="m16 16 5 5" /></svg>
            </button>
          </form>
        </div>
      </details>
    </nav>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const toggle = header?.querySelector<HTMLButtonElement>('.nav-toggle-label');
  const search = header?.querySelector<HTMLDetailsElement>('.nav-search');
  const summary = search?.querySelector('summary');
  const query = search?.querySelector<HTMLInputElement>('input');
  const mobile = window.matchMedia('(max-width: 1024px)');
  const submenuToggles = header?.querySelectorAll<HTMLButtonElement>('.submenu-toggle');
  const collapseSubmenus = (container: Element) => {
    container.querySelectorAll<HTMLButtonElement>('.submenu-toggle').forEach(button => {
      button.setAttribute('aria-expanded', 'false');
      button.parentElement?.classList.remove('is-expanded');
    });
  };
  submenuToggles?.forEach(button => button.addEventListener('click', () => {
    const open = button.getAttribute('aria-expanded') !== 'true';
    button.setAttribute('aria-expanded', String(open));
    button.parentElement?.classList.toggle('is-expanded', open);
    const panel = document.getElementById(button.getAttribute('aria-controls')!);
    if (!open && panel) collapseSubmenus(panel);
  }));
  const brandRow = header?.querySelector<HTMLElement>('.brand-row');
  if (header && brandRow) {
    const updateHeaderHeight = () => header.style.setProperty('--mobile-header-height', `${brandRow.getBoundingClientRect().height}px`);
    updateHeaderHeight();
    new ResizeObserver(updateHeaderHeight).observe(brandRow);
  }
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') !== 'true';
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? '關閉選單' : '開啟選單');
    header?.classList.toggle('nav-open', open);
    if (!open && header) {
      collapseSubmenus(header);
      if (search) search.open = false;
    }
  });
  mobile.addEventListener('change', () => {
    if (!mobile.matches && toggle?.getAttribute('aria-expanded') === 'true') toggle.click();
  });
  search?.addEventListener('toggle', () => {
    summary?.setAttribute('aria-label', search.open ? '關閉搜尋' : '開啟搜尋');
    if (search.open) query?.focus();
  });
  document.addEventListener('click', (event) => {
    if (search?.open && event.target instanceof Node && !search.contains(event.target)) search.open = false;
    if (mobile.matches && toggle?.getAttribute('aria-expanded') === 'true' && event.target instanceof Node && !header?.contains(event.target)) toggle.click();
  });
  search?.addEventListener('focusout', (event) => {
    if (event.relatedTarget instanceof Node && !search.contains(event.relatedTarget)) search.open = false;
  });
  header?.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    if (search?.open) {
      search.open = false;
      summary?.focus();
    } else if (toggle?.getAttribute('aria-expanded') === 'true') {
      toggle.click();
      toggle.focus();
    }
  });
</script>
