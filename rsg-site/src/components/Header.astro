---
import { site } from '../site';
const current = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
const isActive = (href: string) => href === current || (href !== '/' && current.startsWith(href + '/'));
---
<header class="site-header">
  <div class="container bar">
    <a class="brand" href="/" aria-label={site.name}>
      <img src={site.logo} alt="" width="40" height="40" />
      <span class="wordmark">{site.shortName}<small>Relationship Garden</small></span>
    </a>
    <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-hidden="true" />
    <label for="nav-toggle" class="nav-toggle-label" aria-label="開啟選單"><span></span><span></span><span></span></label>
    <nav class="nav" aria-label="主選單">
      {site.nav.map((item) => (
        <a
          href={item.href}
          class:list={[{ external: 'external' in item && item.external }]}
          aria-current={isActive(item.href) ? 'page' : undefined}
          target={'external' in item && item.external ? '_blank' : undefined}
          rel={'external' in item && item.external ? 'noopener' : undefined}
        >{item.label}</a>
      ))}
      <a href="/search" aria-label="搜尋">搜尋</a>
    </nav>
  </div>
</header>
