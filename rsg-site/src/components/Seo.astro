---
// 每頁的 <head> 標籤：title、description、canonical、Open Graph、JSON-LD。
// JSON-LD 的 Organization 資料來自 ../site.ts（與問答站共用同一份）。
import { site, org } from '../site';

interface Props {
  title: string;
  description?: string;
  /** 不含網域的路徑，例如 /about-2；沒給就用目前網址 */
  path?: string;
  image?: string;
  type?: 'website' | 'article' | 'event';
  noindex?: boolean;
  datePublished?: string;
  dateModified?: string;
  /** 額外的 JSON-LD 物件（Article、Event…） */
  jsonLd?: Record<string, unknown>[];
  breadcrumbs?: { name: string; path: string }[];
}

const {
  title,
  description = site.description,
  path = Astro.url.pathname,
  image,
  type = 'website',
  noindex = false,
  datePublished,
  dateModified,
  jsonLd = [],
  breadcrumbs = [],
} = Astro.props;

const isHome = path === '/';
const fullTitle = isHome ? site.name : `${title}｜${site.shortName}`;
const canonical = new URL(path, site.url).href;
const ogImage = new URL(image || site.ogImage, site.url).href;

const organization = {
  '@type': 'Organization',
  '@id': `${site.url}/#organization`,
  name: org.name,
  alternateName: org.alternateName,
  url: org.url,
  logo: new URL(site.logo, site.url).href,
  foundingDate: org.foundingDate,
  description: org.description,
  areaServed: org.areaServed,
  sameAs: org.sameAs,
  founder: org.founders.map((f) => ({ '@type': 'Person', name: f.name, jobTitle: f.jobTitle, url: f.url })),
};

const website = {
  '@type': 'WebSite',
  '@id': `${site.url}/#website`,
  url: `${site.url}/`,
  name: site.name,
  inLanguage: site.language,
  publisher: { '@id': `${site.url}/#organization` },
  potentialAction: {
    '@type': 'SearchAction',
    target: { '@type': 'EntryPoint', urlTemplate: `${site.url}/search?q={search_term_string}` },
    'query-input': 'required name=search_term_string',
  },
};

const breadcrumbList = breadcrumbs.length
  ? {
      '@type': 'BreadcrumbList',
      itemListElement: [{ name: '首頁', path: '/' }, ...breadcrumbs].map((b, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: b.name,
        item: new URL(b.path, site.url).href,
      })),
    }
  : null;

const graph = {
  '@context': 'https://schema.org',
  '@graph': [organization, website, breadcrumbList, ...jsonLd].filter(Boolean),
};
---
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, follow" />}
<meta property="og:site_name" content={site.name} />
<meta property="og:type" content={type === 'website' ? 'website' : 'article'} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:locale" content="zh_TW" />
{datePublished && <meta property="article:published_time" content={datePublished} />}
{dateModified && <meta property="article:modified_time" content={dateModified} />}
<meta name="twitter:card" content="summary_large_image" />
<link rel="alternate" type="application/rss+xml" title={`${site.shortName} 文章`} href="/feed.xml" />
<script type="application/ld+json" set:html={JSON.stringify(graph)} />
