---
import Appointment from '../components/Appointment.astro';
interface Props {
  hero: { src: string; alt: string; width: number; height: number };
  appointment?: boolean;
}
const { hero, appointment = false } = Astro.props;
---
<article class="service-page">
  <img class="page-banner" src={hero.src} alt={hero.alt} width={hero.width} height={hero.height} fetchpriority="high" />
  <div class="service-content"><slot /></div>
  {appointment && <Appointment />}
</article>
