---
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BackToTop from '../components/BackToTop.astro';
import FloraChat from '../components/FloraChat.astro';
import RevealEffects from '../components/RevealEffects.astro';
import '../styles/presentation.css';
import { site } from '../site';

type SeoProps = Parameters<typeof Seo>[0];
interface Props extends SeoProps {
  /** Pagefind 索引用：false 表示這頁不進站內搜尋 */
  searchable?: boolean;
}
const { searchable = true, ...seo } = Astro.props;
---
<!doctype html>
<html lang={site.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/media/2025/11/RsgLogo-favicon.png" type="image/png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700&family=Noto+Serif+TC:wght@600;700&display=swap" rel="stylesheet" />
    <Seo {...seo} />
    <!-- GA4：沿用舊站既有的評估 ID，讓新舊站流量數據連續（2026-10-09 切換） -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-EGHGM6DDMS"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-EGHGM6DDMS');
    </script>
    <slot name="head" />
  </head>
  <body>
    <Header />
    <main id="main" data-pagefind-body={searchable ? '' : undefined} data-pagefind-ignore={searchable ? undefined : ''}>
      <slot />
    </main>
    <Footer />
    <BackToTop />
    <FloraChat />
    <RevealEffects />
  </body>
</html>
