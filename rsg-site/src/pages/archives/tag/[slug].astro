---
import Base from '../../../layouts/Base.astro';
import PostList from '../../../components/PostList.astro';
import { getPosts, groupByTerm, termSlug } from '../../../lib/content';
import { site } from '../../../site';

export async function getStaticPaths() {
  const groups = groupByTerm(await getPosts(), 'tag');
  return [...groups.entries()].map(([name, posts]) => ({ params: { slug: termSlug('tag', name) }, props: { name, posts } }));
}
const { name, posts } = Astro.props;
const base = `/archives/tag/${encodeURIComponent(Astro.params.slug)}`;
---
<Base title={`#${name}`} description={`${site.shortName}標籤「${name}」的文章。`} path={base} noindex={true} breadcrumbs={[{ name: '文章', path: '/posts' }, { name: `#${name}`, path: base }]}>
  <PostList title={`#${name}`} posts={posts} current={1} totalPages={1} total={posts.length} base={base} />
</Base>
