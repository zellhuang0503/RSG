---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import EventCard from '../components/EventCard.astro';
import { getPosts, getEvents, getHomePage, isUpcoming } from '../lib/content';
import { site } from '../site';

const posts = (await getPosts()).slice(0, site.homeLatestPosts);
const upcoming = (await getEvents()).filter((e) => isUpcoming(e)).reverse().slice(0, site.homeUpcomingEvents);
const home = await getHomePage();
const HomeContent = home ? (await render(home)).Content : null;
---
<Base title={site.name} path="/">
  <section class="hero">
    <div class="container">
      <h1>{site.shortName}</h1>
      <p class="lead">{site.description}</p>
      <div class="cta">
        <a class="btn primary" href="/events">近期課程與工作坊</a>
        <a class="btn" href="/about-2">認識關係花園</a>
        <a class="btn" href="https://shop.rsg.com.tw/" target="_blank" rel="noopener">線上商店</a>
      </div>
    </div>
  </section>

  {HomeContent && (
    <section class="section">
      <div class="container prose"><HomeContent /></div>
    </section>
  )}

  {upcoming.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-head"><h2>即將舉辦</h2><a href="/events">所有課程活動</a></div>
        <div class="grid">{upcoming.map((e) => <EventCard event={e} />)}</div>
      </div>
    </section>
  )}

  <section class="section">
    <div class="container">
      <div class="section-head"><h2>最新文章</h2><a href="/posts">所有文章</a></div>
      {posts.length ? <div class="grid">{posts.map((p) => <PostCard post={p} />)}</div> : <p class="muted">尚無文章。</p>}
    </div>
  </section>
</Base>
